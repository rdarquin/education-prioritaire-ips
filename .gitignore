__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Donnees : on versionne la recette (les scripts), pas les ingredients.
# data/raw est reconstructible a l'identique via `uv run python -m src.download`.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Notes personnelles : espace de brouillon, pas un livrable.
NOTES.md

# Cache HTTP depose par cartiflette a la racine du projet.
http_cache.sqlite

